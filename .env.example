DATABASE_URL=sqlite:///./erp.db
APP_ENV=development
JWT_SECRET=change-this-in-production
JWT_EXPIRE_MINUTES=480
PASSWORD_HASH_ITERATIONS=120000
# ENABLE_DOCS is optional: default is enabled in development and disabled in production.
# ENABLE_DOCS=true
BACKUP_DIR=
INITIAL_OWNER_PASSWORD=
INITIAL_DEVELOPER_PASSWORD=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production: the farm owner sets and stores this key. Keep a separate secure backup; losing it makes encrypted data permanently unreadable.
# Development must use a different key and synthetic data only. Never use the production key for development.
ENCRYPTION_KEY=replace-with-a-fernet-key
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Trust only the direct proxy peer(s); Cloudflare requests use CF-Connecting-IP.
TRUSTED_PROXY_IPS=
LOG_LEVEL=INFO
LOG_DIR=logs
FARM_LATITUDE=18.8072866
FARM_LONGITUDE=99.0930437
FARM_TIMEZONE=Asia/Bangkok
WEATHER_SYNC_HOUR=8
WEATHER_REQUEST_TIMEOUT_SECONDS=3
WEATHER_JOB_TIMEOUT_SECONDS=15
SCHEDULER_MISFIRE_GRACE_SECONDS=21600
WEATHER_FORECAST_CACHE_SECONDS=900
WEATHER_FORECAST_EMPTY_CACHE_SECONDS=30
# Leave unset to disable sensor ingestion. Use a separate high-entropy device token.
DEVICE_TOKEN=

# Morning reminders (08:00 by default, about 2 days ahead).
NOTIFY_HOUR=8
NOTIFY_MINUTE=0
NOTIFY_LEAD_DAYS=2
# Firebase service-account JSON for pushes to the owner's Android phone.
# Keep the file outside git (secrets/ is ignored). Leave unset to keep reminders in the app only.
FCM_CREDENTIALS_FILE=
