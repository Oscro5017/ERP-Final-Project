DATABASE_URL=sqlite:///./erp.db
JWT_SECRET=change-this-in-production
JWT_EXPIRE_MINUTES=480
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production: the farm owner sets and stores this key. Keep a separate secure backup; losing it makes encrypted data permanently unreadable.
# Development must use a different key and synthetic data only. Never use the production key for development.
ENCRYPTION_KEY=replace-with-a-fernet-key
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FARM_LATITUDE=18.8072866
FARM_LONGITUDE=99.0930437
FARM_TIMEZONE=Asia/Bangkok
WEATHER_SYNC_HOUR=8
# Leave unset to disable sensor ingestion. Use a separate high-entropy device token.
DEVICE_TOKEN=
